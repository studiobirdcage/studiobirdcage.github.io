---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import FeaturedSlider from "../components/FeaturedSlider";
import HomePosts from "../components/HomePosts";

const works = (await getCollection("works", ({ data }) => data.featured && !data.draft)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const posts = (await getCollection("posts", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
const postCards = posts.map(({ data }) => ({
    title: data.title,
    slug: data.slug,
    categorySlug: data.categorySlug,
    date: data.date.toLocaleDateString("en-CA", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    }),
    author: data.author,
    excerpt: data.excerpt,
    tags: data.tags,
    image: data.thumbnailImage,
}));
---

<Layout
    title="Barrett Long — Web, Software & Mobile App Developer Portfolio"
    description="Barrett Long's Edmonton developer portfolio showcasing web design, web development, software development, mobile app development, and digital product work."
>
    <h1 class="sr-only">Barrett Long web, software, and mobile app developer portfolio</h1>
    <FeaturedSlider
        works={works.map(({ data }) => ({
            title: data.title,
            slug: data.slug,
            tags: data.tags,
            image: data.thumbnailImage,
        }))}
    />
    <section class="action-call">
        <h3 class="with-line"><span>Thanks for<br />stopping by...</span></h3>
        <p class="mt-20 mb-4">
            I’m Barrett Long, a product-focused software engineer and architect based in Edmonton.
            My background is somewhat unusual. I studied fine art and digital media, began
            professionally in design and web development, and gradually moved into full-stack
            engineering, mobile development, platform architecture, and engineering management. That
            path taught me to look at software from several directions at once. I care about how a
            product feels to use, how its parts fit together, how it performs as it grows, and
            whether another developer can understand it six months later.
        </p>
        <p class="mb-4">
            Since 2017, my primary work was COM•MU•NI•KIT, a community communications platform that
            grew from a single deployment into a SaaS product serving more than 260 communities
            across Canada and the United States. I built significant portions of the original
            product, led its complete redesign, helped grow its engineering team, and remained
            involved in both product and technical decisions throughout its evolution.
        </p>
        <p class="mb-4">
            I’m now looking for opportunities where I can contribute at that same intersection of
            product, architecture, engineering, and user experience.
        </p>
        <div class="mt-20">
            <Button href="/contact">Talk to me about your product</Button>
        </div>
    </section>
    <section class="bg-[#f9f8f9] px-5 py-20 min-[850px]:px-32.5">
        <header class="text-center">
            <h2 class="legacy-h2">Recent Journal Entries</h2><span class="subtitle"
                >Because the internet needs more bloggers</span
            >
        </header><HomePosts posts={postCards} /><div class="mt-20 text-center">
            <Button href="/journal">more journal articles</Button>
        </div>
    </section>
</Layout>
