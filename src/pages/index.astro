---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import FeaturedSlider from "../components/FeaturedSlider";
import HomePosts from "../components/HomePosts";

const works = (
    await getCollection("works", ({ data }) => data.featured && !data.draft)
).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const posts = (await getCollection("posts", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .slice(0, 3);
const postCards = posts.map(({ data }) => ({
    title: data.title,
    slug: data.slug,
    categorySlug: data.categorySlug,
    date: data.date.toLocaleDateString("en-CA", {
        day: "2-digit",
        month: "2-digit",
        year: "numeric",
    }),
    author: data.author,
    excerpt: data.excerpt,
    tags: data.tags,
    image: data.thumbnailImage,
}));
---

<Layout title="Barrett Long — Web, Software & Mobile App Developer Portfolio" description="Barrett Long's Edmonton developer portfolio showcasing web design, web development, software development, mobile app development, and digital product work.">
  <h1 class="sr-only">Barrett Long web, software, and mobile app developer portfolio</h1>
    <FeaturedSlider
        works={works.map(({ data }) => ({
            title: data.title,
            slug: data.slug,
            tags: data.tags,
            image: data.thumbnailImage,
        }))}
    />
    <section class="action-call">
        <h3 class="with-line"><span>Thanks for stopping by...</span></h3><p>
            I’m Barrett Long, a full-stack developer and engineering manager
            based in Edmonton, Alberta, with more than 15 years of experience
            building thoughtful, user-focused software. My work combines strong
            technical expertise with a deep appreciation for UI and UX, allowing
            me to create digital products that are both scalable and intuitive
            to use. Most recently, I spent nearly a decade at Aivia Inc., where
            I served as Software Engineering Manager and Lead Full-Stack
            Developer for Communikit. During that time, I helped grow the
            platform from serving a single community to supporting more than 260
            communities across Canada and the United States.
        </p><div class="mt-20">
            <Button href="/contact">let's build something awesome</Button>
        </div>
    </section>
    <section class="bg-[#f9f8f9] px-5 py-20 min-[850px]:px-[130px]">
        <header class="text-center">
            <h2 class="legacy-h2">Recent Journal Entries</h2><span
                class="subtitle">Because the internet needs more bloggers</span
            >
        </header><HomePosts posts={postCards} /><div class="mt-20 text-center">
            <Button href="/journal">more journal articles</Button>
        </div>
    </section>
</Layout>
