---
import BaseLayout from "../layouts/BaseLayout.astro";
import AsciiBanner from "../components/AsciiBanner.astro";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import { getAllSeries } from "../utils/series";

const posts = await getCollection("blog", ({ data }) => {
    // return import.meta.env.PROD ? data.draft !== true : true;
    return data.draft !== true;
}).then((output) =>
    output.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
);

const newestSeries = getAllSeries(posts).slice(0, 5);

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <ul id="posts" class="flex flex-col gap-12">
        {
            posts.map((post, index) => (
                <li class="border-l-4 border-b-4 border-double border-gl-pink pl-6 pb-4">
                    <a
                        class="block border-b border-dashed border-gl-muted pb-2 hover:bg-gl-cyan/10"
                        href={`/blog/${post.id}/`}
                    >
                        <p class="text-xl tracking-wider text-gl-muted mb-2">
                            ++ Log // {String(index + 1).padStart(2, "0")} ++
                        </p>

                        <AsciiBanner
                            text={post.data.title}
                            font="Pagga"
                            size="1rem"
                            glitchAmount="25%"
                            color="#e0af68"
                            wrapAt="auto"
                        />
                    </a>
                    <p class="mt-2 text-xl text-gl-white">
                        {post.data.description}
                    </p>
                    <p class="mt-2 text-lg text-gl-muted">
                        published <FormattedDate date={post.data.pubDate} />
                    </p>
                </li>
            ))
        }
    </ul>
</BaseLayout>
