---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../../consts";
import { getCollection } from "astro:content";
import AsciiBanner from "../../components/AsciiBanner.astro";

const resources = await getCollection("resources");
---

<BaseLayout
    title={`Resources | ${SITE_TITLE}`}
    description="A super helpful lits of resources"
>
    <section>
        <div class="border-b border-dashed border-gl-muted/70 pb-5">
            <nav class="site-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Index</a>
                <span aria-hidden="true"> / </span>
                <span class="site-breadcrumb__current" aria-current="page">
                    Resources
                </span>
            </nav>

            <h2 class="text-4xl text-gl-pink">Resources</h2>
            <p class="text-xl text-gl-muted">
                {resources.length} total resource{
                    resources.length === 1 ? "" : "s"
                } // ordered by usefulness
            </p>
        </div>

        <section class="mt-10">
            {
                resources.length > 0 ? (
                    <ol class="flex flex-col gap-12">
                        {resources.map((item, index) => (
                            <li class="border-l-4 border-b-4 border-double border-gl-pink pl-6 pb-4">
                                <a
                                    class="block border-b border-dashed border-gl-muted pb-2 text-3xl text-gl-yellow hover:bg-gl-cyan/10 hover:text-gl-cyan"
                                    href={`${item.data.url}`}
                                    target="_blank"
                                >
                                    <p class="text-xl tracking-wider text-gl-muted mb-2">
                                        ++ {item.data.category} //{" "}
                                        {String(index + 1).padStart(2, "0")} ++
                                    </p>
                                    <AsciiBanner
                                        text={item.data.title}
                                        font="Pagga"
                                        wrapAt="auto"
                                        glitchColor="var(--color-gl-pink)"
                                        color="var(--color-gl-cyan)"
                                        size="0.75rem"
                                    />
                                </a>
                                <p class="mt-2 text-xl text-gl-muted">
                                    {item.data.description}
                                </p>
                            </li>
                        ))}
                    </ol>
                ) : (
                    <p class="text-2xl text-gl-muted">
                        No resources have been indexed yet.
                    </p>
                )
            }
        </section>
    </section>
</BaseLayout>
