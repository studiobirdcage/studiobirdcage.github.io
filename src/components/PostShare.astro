---
const { url, title } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<ul class="flex list-none items-center gap-8 p-0">
    <li class="font-sans text-xl text-[#00fdc7] uppercase">Share</li><li>
        <a
            class="social-icon block text-[#cdcccf] hover:text-[#00fdc7]"
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
            target="_blank"
            rel="noreferrer"
            aria-label="Share on Facebook">&#xf082;</a
        >
    </li><li>
        <a
            class="social-icon block text-[#cdcccf] hover:text-[#00fdc7]"
            href={`https://twitter.com/intent/tweet?text=${encodedTitle}&hashtags=softwareengineering,webdevelopment&url=${encodedUrl}`}
            target="_blank"
            rel="noreferrer"
            aria-label="Share on Twitter">&#xf099;</a
        >
    </li>
</ul>
