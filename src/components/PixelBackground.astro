<canvas class="pixel-background" data-pixel-background aria-hidden="true"></canvas>

<style>
    .pixel-background {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        pointer-events: none;
        background: var(--color-gl-black);
    }

    @media (prefers-reduced-motion: reduce) {
        .pixel-background {
            display: none;
        }
    }
</style>

<script>
    const canvas = document.querySelector("[data-pixel-background]");

    if (
        canvas instanceof HTMLCanvasElement &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
        const ctx = canvas.getContext("2d");
        const colors = [
            "#7aa2f7",
            "#7dcfff",
            "#bb9af7",
            "#ff007c",
            "#565f89",
        ];
        const glyphs = [".", ":", "+", "*", "#", "%", "@", "░", "▒", "▓", "<", ">", "/"]; 

        let width = 0;
        let height = 0;
        let dpr = 1;
        let particles = [];
        let animationFrame = 0;
        let lastSpawn = 0;
        let nextGlyphGlitch = 0;

        function randomBetween(min, max) {
            return min + Math.random() * (max - min);
        }

        function randomInt(min, max) {
            return Math.floor(randomBetween(min, max + 1));
        }

        function pick(items) {
            return items[Math.floor(Math.random() * items.length)];
        }

        function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = window.innerWidth;
            height = window.innerHeight;

            canvas.width = Math.floor(width * dpr);
            canvas.height = Math.floor(height * dpr);
            canvas.style.width = `${width}px`;
            canvas.style.height = `${height}px`;

            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function spawnParticle() {
            const cell = Math.random() > 0.82 ? 6 : 3;

            particles.push({
                x: Math.floor(randomBetween(0, width) / cell) * cell,
                y: Math.floor(randomBetween(0, height) / cell) * cell,
                size: cell,
                color: pick(colors),
                alpha: randomBetween(0.06, 0.34),
                life: randomBetween(1400, 3400),
                age: 0,
                driftX: randomBetween(-0.12, 0.12),
                driftY: randomBetween(-0.12, 0.12),
                flicker: randomBetween(0.65, 1.35),
                glyph: "",
                glyphColor: "",
                glyphUntil: 0,
                glyphAlpha: 0,
                glyphSize: 1,
            });
        }

        function triggerGlyphGlitch(timestamp) {
            if (particles.length === 0) return;

            const count = Math.min(particles.length, width < 700 ? 8 : 22);

            for (let i = 0; i < count; i += 1) {
                const particle = particles[randomInt(0, particles.length - 1)];
                if (!particle) continue;

                particle.glyph = pick(glyphs);
                particle.glyphColor = pick(colors);
                particle.glyphUntil = timestamp + randomBetween(260, 620);
                particle.glyphAlpha = randomBetween(0.46, 0.78);
                particle.glyphSize = randomBetween(2.2, 3.2);
            }
        }

        function drawParticle(particle, alpha, timestamp) {
            const isGlyph = timestamp < particle.glyphUntil;

            if (isGlyph) {
                const glyphSize = Math.max(8, particle.size * particle.glyphSize);
                const glyphAlpha = Math.min(
                    particle.glyphAlpha || 0.6,
                    Math.max(0.34, alpha * 2.5),
                );

                ctx.globalAlpha = glyphAlpha;
                ctx.fillStyle = particle.glyphColor || particle.color;
                ctx.font = `${glyphSize}px "VT323", monospace`;
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                ctx.fillText(
                    particle.glyph,
                    particle.x + particle.size * 0.5,
                    particle.y + particle.size * 0.5,
                );
                return;
            }

            ctx.globalAlpha = alpha;
            ctx.fillStyle = particle.color;
            ctx.fillRect(particle.x, particle.y, particle.size, particle.size);

            if (particle.size >= 6 && alpha > 0.1) {
                ctx.globalAlpha = alpha * 0.35;
                ctx.fillRect(
                    particle.x - particle.size,
                    particle.y,
                    particle.size,
                    particle.size,
                );
            }
        }

        function draw(timestamp) {
            if (!ctx) return;

            const delta = Math.min(32, timestamp - (draw.lastTime || timestamp));
            draw.lastTime = timestamp;

            ctx.clearRect(0, 0, width, height);

            const gradient = ctx.createLinearGradient(0, 0, 0, height);
            gradient.addColorStop(0, "#1a1b26");
            gradient.addColorStop(1, "#16161e");
            ctx.fillStyle = gradient;
            ctx.fillRect(0, 0, width, height);

            if (!nextGlyphGlitch) {
                nextGlyphGlitch = timestamp + randomBetween(650, 1600);
            }

            if (timestamp > nextGlyphGlitch) {
                triggerGlyphGlitch(timestamp);
                nextGlyphGlitch = timestamp + randomBetween(850, 2100);
            }

            if (timestamp - lastSpawn > 18) {
                const spawnCount = width < 700 ? 3 : 7;
                for (let i = 0; i < spawnCount; i += 1) spawnParticle();
                lastSpawn = timestamp;
            }

            particles = particles.filter((particle) => {
                particle.age += delta;
                particle.x += particle.driftX * delta;
                particle.y += particle.driftY * delta;

                const progress = particle.age / particle.life;
                if (progress >= 1) return false;

                const fade = Math.sin(progress * Math.PI);
                const flicker =
                    0.72 + Math.sin(timestamp * 0.012 * particle.flicker) * 0.28;
                const alpha = particle.alpha * fade * flicker;

                drawParticle(particle, alpha, timestamp);

                return true;
            });

            ctx.globalAlpha = 1;

            animationFrame = window.requestAnimationFrame(draw);
        }

        resize();

        for (
            let i = 0;
            i < Math.floor((width * height) / (width < 700 ? 7000 : 4500));
            i += 1
        ) {
            spawnParticle();
            const particle = particles[particles.length - 1];
            particle.age = randomBetween(0, particle.life * 0.85);
        }

        window.addEventListener("resize", resize, { passive: true });
        animationFrame = window.requestAnimationFrame(draw);

        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") {
                draw.lastTime = 0;
                animationFrame = window.requestAnimationFrame(draw);
            } else {
                window.cancelAnimationFrame(animationFrame);
            }
        });
    }
</script>
