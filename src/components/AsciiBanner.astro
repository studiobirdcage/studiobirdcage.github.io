---
import { DEFAULT_ASCII_FONT, generateAscii } from "../utils/ascii";

const {
    text = "Astro",
    lines,
    size,
    color,
    glitchColor,
    glitchTone = "lighter",
    glitchAmount = "35%",
    wrapAt,
    autoWrap = false,
    font = DEFAULT_ASCII_FONT,
    fonts,
    class: className = "",
} = Astro.props;

const rawBannerLines = Array.isArray(lines)
    ? lines.map(String)
    : String(text).split(/\r?\n/);
const shouldAutoWrap = autoWrap === true || wrapAt === "auto";
const wrapLength = shouldAutoWrap ? Number.NaN : Number(wrapAt);

function wrapWords(line: string, maxLength: number) {
    if (!Number.isFinite(maxLength) || maxLength <= 0) return [line];

    const words = line.trim().split(/\s+/).filter(Boolean);
    if (words.length === 0) return [line];

    const wrapped: string[] = [];
    let current = "";

    for (const word of words) {
        const next = current ? `${current} ${word}` : word;

        if (next.length > maxLength && current) {
            wrapped.push(current);
            current = word;
        } else {
            current = next;
        }
    }

    if (current) wrapped.push(current);
    return wrapped;
}

function getAsciiWidth(art: string) {
    return Math.max(...art.split("\n").map((line) => line.length), 0);
}

const bannerLines = rawBannerLines.flatMap((line) => wrapWords(line, wrapLength));
const fontChoices = Array.isArray(fonts) ? fonts : [font];
const getLineFont = (index: number) =>
    fontChoices[index] ?? fontChoices[fontChoices.length - 1] ?? DEFAULT_ASCII_FONT;

const asciiArt = (
    await Promise.all(
        bannerLines.map((line, index) => generateAscii(line, getLineFont(index))),
    )
)
    .map((art) => art.trimEnd())
    .join("\n");

const responsiveLayout = shouldAutoWrap
    ? await Promise.all(
          rawBannerLines.map(async (line, lineIndex) => {
              const words = line.trim().split(/\s+/).filter(Boolean);
              const lineFont = getLineFont(lineIndex);
              const blocks = [];

              for (let start = 0; start < words.length; start += 1) {
                  for (let end = start + 1; end <= words.length; end += 1) {
                      const phrase = words.slice(start, end).join(" ");
                      const art = (await generateAscii(phrase, lineFont)).trimEnd();

                      blocks.push({
                          start,
                          end,
                          art,
                          width: getAsciiWidth(art),
                      });
                  }
              }

              return { words, blocks };
          }),
      )
    : undefined;

const layoutJson = responsiveLayout
    ? JSON.stringify(responsiveLayout).replace(/</g, "\\u003c")
    : "";

const glitchTint = glitchTone === "darker" ? "black" : "white";
const styleVars = [
    size ? `--ascii-size: ${size}` : undefined,
    color ? `--ascii-color: ${color}` : undefined,
    glitchColor
        ? `--ascii-glitch-color: ${glitchColor}`
        : `--ascii-glitch-color: color-mix(in srgb, var(--ascii-color), ${glitchTint} ${glitchAmount})`,
]
    .filter(Boolean)
    .join("; ");
---

<div
    class:list={["ascii-glitch", className]}
    style={styleVars || undefined}
    data-ascii-glitch
    data-ascii-auto-wrap={shouldAutoWrap ? "true" : undefined}
>
    <pre class="ascii-glitch__text">{asciiArt}</pre>
    {
        shouldAutoWrap && (
            <script
                type="application/json"
                class="ascii-glitch__layout-data"
                set:html={layoutJson}
            />
        )
    }
</div>

<style>
    .ascii-glitch {
        --ascii-size: 1rem;
        --ascii-color: #b6ff2e;
        --ascii-glitch-color: color-mix(in srgb, var(--ascii-color), white 35%);

        display: inline-block;
        max-width: 100%;
        overflow: visible;
        vertical-align: top;
        color: var(--ascii-color);
        filter: drop-shadow(0 0 8px color-mix(in srgb, var(--ascii-color), transparent 86%));
    }

    .ascii-glitch__text {
        margin: 0;
        font-family: "Courier New", "Lucida Console", monospace;
        font-size: var(--ascii-size);
        line-height: 1;
        letter-spacing: 0;
        white-space: pre;
        font-variant-ligatures: none;
        color: inherit;
        text-shadow: 0 0 7px color-mix(in srgb, var(--ascii-color), transparent 82%);
    }

    .ascii-glitch__text :global(.ascii-glitch__char) {
        color: var(--ascii-glitch-color);
        text-shadow: 0 0 7px color-mix(in srgb, var(--ascii-glitch-color), transparent 45%);
    }
</style>

<script>
    const GLITCH_CHARS = "!<>-_\\/[]{}=+*^?#░▒▓";

    function randomBetween(min, max) {
        return min + Math.random() * (max - min);
    }

    function randomInt(min, max) {
        return Math.floor(randomBetween(min, max + 1));
    }

    function chance(amount) {
        return Math.random() < amount;
    }

    function escapeHtml(char) {
        if (char === "&") return "&amp;";
        if (char === "<") return "&lt;";
        if (char === ">") return "&gt;";
        return char;
    }

    function escapeText(text) {
        return text.split("").map(escapeHtml).join("");
    }

    function getCharacterWidth(pre) {
        const styles = window.getComputedStyle(pre);
        const probe = document.createElement("span");

        probe.textContent = "0".repeat(80);
        probe.style.position = "absolute";
        probe.style.left = "-9999px";
        probe.style.top = "0";
        probe.style.visibility = "hidden";
        probe.style.whiteSpace = "pre";
        probe.style.fontFamily = styles.fontFamily;
        probe.style.fontSize = styles.fontSize;
        probe.style.fontWeight = styles.fontWeight;
        probe.style.fontStyle = styles.fontStyle;
        probe.style.letterSpacing = styles.letterSpacing;
        probe.style.lineHeight = styles.lineHeight;

        document.body.appendChild(probe);
        const width = probe.getBoundingClientRect().width / 80;
        probe.remove();

        return width || 8;
    }

    function getAvailableColumns(wrapper, pre) {
        const parent = wrapper.parentElement;
        const availableWidth =
            parent?.clientWidth || document.documentElement.clientWidth || window.innerWidth;
        const characterWidth = getCharacterWidth(pre);

        return Math.max(1, Math.floor((availableWidth - 2) / characterWidth));
    }

    function buildBlockMaps(layoutData) {
        return layoutData.map((line) => {
            const map = new Map();

            line.blocks.forEach((block) => {
                map.set(`${block.start}:${block.end}`, block);
            });

            return { ...line, map };
        });
    }

    function layoutResponsiveAscii(layoutData, maxColumns) {
        return layoutData
            .flatMap((line) => {
                if (!line.words.length) return [""];

                const rendered = [];
                let start = 0;

                while (start < line.words.length) {
                    let best = line.map.get(`${start}:${start + 1}`);

                    for (let end = line.words.length; end > start; end -= 1) {
                        const candidate = line.map.get(`${start}:${end}`);

                        if (candidate && candidate.width <= maxColumns) {
                            best = candidate;
                            break;
                        }
                    }

                    if (!best) break;

                    rendered.push(best.art);
                    start = best.end;
                }

                return rendered;
            })
            .join("\n");
    }

    function replacementFor(char) {
        if (/[A-Z]/.test(char)) return String.fromCharCode(65 + randomInt(0, 25));
        if (/[a-z]/.test(char)) return String.fromCharCode(97 + randomInt(0, 25));
        if (/[0-9]/.test(char)) return String(randomInt(0, 9));
        return GLITCH_CHARS[randomInt(0, GLITCH_CHARS.length - 1)] ?? char;
    }

    function renderChars(chars) {
        return chars
            .map(({ char, mutated }) => {
                const safeChar = escapeHtml(char);
                if (!mutated || /\s/.test(char)) return safeChar;
                return `<span class="ascii-glitch__char">${safeChar}</span>`;
            })
            .join("");
    }

    function shiftSlice(chars, start, end) {
        const slice = chars.slice(start, end);
        const text = slice.map(({ char }) => char).join("");
        const amount = randomInt(-3, 3);
        if (amount === 0 || !text.trim()) return;

        const shiftedText =
            amount > 0
                ? `${" ".repeat(amount)}${text}`.slice(0, text.length)
                : `${text.slice(Math.min(-amount, text.length))}${" ".repeat(Math.min(-amount, text.length))}`;

        const shifted = shiftedText.split("").map((char) => ({
            char,
            mutated: !/\s/.test(char),
        }));

        chars.splice(start, end - start, ...shifted);
    }

    function mutateLineHtml(line, strength, start, end) {
        const chars = line.split("").map((char) => ({ char, mutated: false }));
        const safeStart = Math.max(0, Math.min(start, chars.length));
        const safeEnd = Math.max(safeStart, Math.min(end, chars.length));
        const visibleIndexes = chars
            .map(({ char }, index) => ({ char, index }))
            .filter(
                ({ char, index }) =>
                    index >= safeStart && index < safeEnd && !/\s/.test(char),
            );

        if (visibleIndexes.length === 0) return escapeText(line);

        if (chance(0.5 * strength)) shiftSlice(chars, safeStart, safeEnd);

        const mutationCount = Math.max(
            3,
            Math.floor(visibleIndexes.length * randomBetween(0.22, 0.46) * strength),
        );

        for (let i = 0; i < mutationCount; i += 1) {
            const target = visibleIndexes[randomInt(0, visibleIndexes.length - 1)];
            if (!target) continue;

            const current = chars[target.index];
            if (!current || /\s/.test(current.char)) continue;

            if (chance(0.14)) current.char = " ";
            else if (chance(0.18)) current.char = ".";
            else current.char = replacementFor(current.char);

            current.mutated = !/\s/.test(current.char);
        }

        return renderChars(chars);
    }

    function mutateAsciiHtml(original, strength) {
        const lines = original.split("\n");
        const width = Math.max(...lines.map((line) => line.length), 0);
        const nonEmptyRows = lines
            .map((line, index) => ({ line, index }))
            .filter(({ line }) => line.trim().length > 0);

        if (nonEmptyRows.length === 0 || width === 0) return escapeText(original);

        const regionCount = randomInt(2, Math.min(4, nonEmptyRows.length));
        const regions = Array.from({ length: regionCount }, () => {
            const firstRow =
                nonEmptyRows[randomInt(0, nonEmptyRows.length - 1)]?.index ?? 0;
            const rowSpan = randomInt(2, Math.min(6, nonEmptyRows.length));
            const startCol = randomInt(0, Math.max(0, width - 12));
            const endCol = Math.min(
                width,
                startCol + randomInt(18, Math.min(62, width)),
            );

            return { firstRow, rowSpan, startCol, endCol };
        });

        return lines
            .map((line, index) => {
                let html = escapeText(line);

                for (const region of regions) {
                    if (
                        index >= region.firstRow &&
                        index < region.firstRow + region.rowSpan
                    ) {
                        html = mutateLineHtml(
                            line,
                            strength,
                            region.startCol,
                            region.endCol,
                        );
                        break;
                    }
                }

                return html;
            })
            .join("\n");
    }

    function bootAsciiGlitch() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        document.querySelectorAll("[data-ascii-glitch]").forEach((wrapper) => {
            if (!(wrapper instanceof HTMLElement) || wrapper.dataset.ready) return;
            wrapper.dataset.ready = "true";

            const pre = wrapper.querySelector(".ascii-glitch__text");
            if (!(pre instanceof HTMLElement)) return;

            const layoutDataElement = wrapper.querySelector(".ascii-glitch__layout-data");
            const layoutData = layoutDataElement?.textContent
                ? buildBlockMaps(JSON.parse(layoutDataElement.textContent))
                : undefined;

            let original = pre.textContent ?? "";
            if (!original) return;

            let timeout = 0;
            let interval = 0;
            let animationFrame = 0;
            let isGlitching = false;

            function setOriginal(next) {
                original = next;
                if (!isGlitching) pre.textContent = original;
            }

            function relayout() {
                if (!layoutData) return;

                const columns = getAvailableColumns(wrapper, pre);
                const next = layoutResponsiveAscii(layoutData, columns);

                if (next && next !== original) setOriginal(next);
            }

            function requestRelayout() {
                window.cancelAnimationFrame(animationFrame);
                animationFrame = window.requestAnimationFrame(relayout);
            }

            if (layoutData) {
                requestRelayout();

                const resizeObserver = new ResizeObserver(requestRelayout);
                resizeObserver.observe(wrapper.parentElement ?? wrapper);

                document.fonts?.ready.then(requestRelayout);
            }

            function schedule() {
                window.clearTimeout(timeout);
                timeout = window.setTimeout(() => burst(1), randomBetween(2800, 7600));
            }

            function finish() {
                window.clearInterval(interval);
                isGlitching = false;
                pre.textContent = original;
                schedule();
            }

            function burst(strength) {
                window.clearTimeout(timeout);

                let frame = 0;
                const frames = randomInt(5, 9);

                isGlitching = true;
                interval = window.setInterval(() => {
                    pre.innerHTML = mutateAsciiHtml(original, strength);
                    frame += 1;

                    if (frame >= frames) {
                        finish();
                    }
                }, randomBetween(55, 95));
            }

            wrapper.addEventListener("mouseenter", () => burst(1.75));
            schedule();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootAsciiGlitch);
    } else {
        bootAsciiGlitch();
    }
</script>
