---
const pathname = Astro.url.pathname;
const navItems = [
    { href: "/", label: "Home" },
    { href: "/about", label: "About" },
    { href: "/works", label: "Works" },
    { href: "/journal", label: "Journal" },
    { href: "/contact", label: "Contact" },
];
import SocialMedia from "./SocialMedia.astro";
import { Image } from "astro:assets";
---

<header class="fixed inset-x-0 top-0 z-50 h-20 bg-white min-[501px]:max-[959px]:h-25">
    <div
        class="relative flex h-full items-center justify-between px-2.5 min-[501px]:max-[959px]:px-5 min-[960px]:px-20"
    >
        <a
            href="/"
            aria-label="Barrett Long home"
            class="group inline-flex items-center gap-3 text-[#121212]"
        >
            <span
                aria-hidden="true"
                class="solid-icon grid size-8 place-items-center rounded-md border-2 border-current bg-white text-[15px] text-current shadow-[2px_2px_0_#00fdc7] transition-all group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:shadow-none"
            >
                &#xf120;
            </span>
            <span class="text-[20px] leading-none tracking-[1.5px] text-current uppercase">
                Barrett Long
            </span>
        </a>

        <button id="menu-open" class="group h-5 w-7.5 cursor-pointer" aria-label="Open navigation"
            ><Image
                class="h-full w-full drop-shadow-[2px_2px_0_#00fdc7] transition-all group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:drop-shadow-none"
                src="/images/app/menu_icon.svg"
                width={36}
                height={26}
                alt="stacked menu icon"
                loading="eager"
            /></button
        >
    </div>
</header>
<div
    id="site-menu"
    class="pointer-events-none fixed top-20 left-0 z-40 grid h-[calc(100vh-80px)] w-screen overflow-hidden opacity-0 transition-opacity duration-500 min-[501px]:max-[959px]:top-25 min-[501px]:max-[959px]:h-[calc(100vh-100px)] min-[960px]:left-20 min-[960px]:w-[calc(100vw-160px)] min-[960px]:grid-cols-[3fr_2fr]"
>
    <section
        class="hidden h-full -translate-x-full items-center justify-center bg-[#121212] p-20 transition-transform duration-600 min-[960px]:flex"
    >
        <span
            aria-hidden="true"
            class="solid-icon grid size-[clamp(12rem,25vw,20rem)] place-items-center rounded-4xl border-8 border-white text-[clamp(5rem,12vw,9rem)] text-white shadow-[12px_12px_0_#00fdc7]"
        >
            &#xf120;
        </span>
    </section>
    <nav
        class="relative flex h-full min-h-0 translate-x-full flex-col justify-between overflow-y-auto bg-[#f9f8f9] p-[clamp(30px,8vh,80px)] transition-transform duration-600"
    >
        <button
            id="menu-close"
            class="group absolute top-7 right-7 h-8 w-8 cursor-pointer p-1"
            aria-label="Close navigation"
            ><Image
                class="h-full w-full drop-shadow-[2px_2px_0_#00fdc7] transition-all group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-hover:drop-shadow-none"
                src="/images/app/menu_close_icon.svg"
                width={21}
                height={21}
                alt=""
            /></button
        >
        <ul class="mt-10 shrink-0">
            {
                navItems.map(({ href, label }) => (
                    <li class="py-2">
                        <a
                            class:list={[
                                "menu-link",
                                (pathname === href ||
                                    (href !== "/" && pathname.startsWith(href))) &&
                                    "menu-link-active",
                            ]}
                            href={href}
                        >
                            {label}
                        </a>
                    </li>
                ))
            }
        </ul>
        <div
            class="mt-10 shrink-0 text-[clamp(12px,1.25vw,16px)] leading-[1.4] text-[#808080]"
            style="font-family: 'Neue Plak Thin', Arial, sans-serif"
        >
            11716 37B Ave NW<br />Edmonton, Alberta<br />T6J 0K4<br />Canada<br />780.235.0132<a
                class="mt-4 block text-[#121212]"
                style="font-family: 'Neue Plak ExtraBlack', Arial, sans-serif"
                href="mailto:b@rrett.dev">b@rrett.dev</a
            ><div class="mt-4 h-0.5 w-3/4 bg-[#00fdc7]"></div><div class="menu-social mt-2">
                <SocialMedia />
            </div><p class="mt-2" style="font-family: 'Neue Plak Regular', Arial, sans-serif">
                © {new Date().getFullYear()} Barrett Long
            </p>
        </div>
    </nav>
</div>
<script>
    const menu = document.querySelector("#site-menu");
    const open = document.querySelector("#menu-open");
    const close = document.querySelector("#menu-close");
    const toggle = (visible: boolean) => {
        menu?.classList.toggle("pointer-events-none", !visible);
        menu?.classList.toggle("opacity-0", !visible);
        menu?.querySelector("section")?.classList.toggle("-translate-x-full", !visible);
        menu?.querySelector("nav")?.classList.toggle("translate-x-full", !visible);
        document.body.classList.toggle("overflow-hidden", visible);
    };
    open?.addEventListener("click", () => toggle(true));
    close?.addEventListener("click", () => toggle(false));
</script>
