---
import AsciiBanner from "./AsciiBanner.astro";
import GlitchLogo from "./GlitchLogo.astro";
---

<header class="pt-10 pb-10">
    <div class="border-b border-dashed border-gl-muted/70 pb-4">
        <div class="flex flex-row items-stretch justify-between gap-4">
            <div>
                <a
                    href="/"
                    class="group min-w-0 text-gl-white flex-1"
                    aria-label="Studio Birdcage home"
                >
                    <p
                        class="mb-2 text-base leading-none tracking-[0.22em] text-gl-muted sm:text-xl"
                    >
                        ++ life's short // build shit ++
                    </p>
                    <AsciiBanner
                        text={"Studio Birdcage"}
                        color="var(--color-gl-pink)"
                        glitchColor="var(--color-gl-yellow)"
                        wrapAt="auto"
                        size="0.8rem"
                        font="ANSI Shadow"
                        class="mb-2"
                    />
                </a>
                <nav
                    class="flex flex-nowrap justify-start gap-x-3 border-dashed border-gl-muted/70 text-lg uppercase tracking-wider whitespace-nowrap text-gl-muted sm:gap-x-4 sm:text-xl"
                    aria-label="Primary navigation"
                >
                    <a class="hover:bg-gl-cyan/10 hover:text-gl-cyan" href="/">
                        [index]
                    </a>
                    <a
                        class="hover:bg-gl-cyan/10 hover:text-gl-cyan"
                        href="/series/"
                    >
                        [series]
                    </a>
                    <a
                        class="hover:bg-gl-cyan/10 hover:text-gl-cyan"
                        href="/rss.xml"
                    >
                        [rss]
                    </a>
                </nav>
            </div>

            <div class="flex shrink-0 flex-col items-end justify-between gap-3">
                <div class="flex flex-1 items-center pr-4">
                    <a href="/" aria-label="Studio Birdcage home">
                        <GlitchLogo
                            size="5.75rem"
                            color="var(--color-gl-cyan)"
                            glitchColor="var(--color-gl-pink)"
                        />
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>
