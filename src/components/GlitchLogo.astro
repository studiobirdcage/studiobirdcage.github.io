---
import logoUrl from "../assets/studio_birdcage_logo.svg?url";

const {
    size = "4.5rem",
    color = "var(--color-gl-cyan)",
    glitchColor = "var(--color-gl-pink)",
    class: className = "",
    label = "Studio Birdcage logo",
} = Astro.props;

const styleVars = [
    `--logo-size: ${size}`,
    `--logo-color: ${color}`,
    `--logo-glitch-color: ${glitchColor}`,
    `--logo-url: url(${logoUrl})`,
].join("; ");
---

<span
    class:list={["logo-glitch", className]}
    style={styleVars}
    role="img"
    aria-label={label}
    data-logo-glitch
>
    <span class="logo-glitch__layer logo-glitch__layer--base"></span>
    <span class="logo-glitch__layer logo-glitch__layer--hot" aria-hidden="true"></span>
    <span class="logo-glitch__layer logo-glitch__layer--cold" aria-hidden="true"></span>
    <span class="logo-glitch__scan" aria-hidden="true"></span>
</span>

<style>
    .logo-glitch {
        --logo-size: 4.5rem;
        --logo-color: var(--color-gl-cyan);
        --logo-glitch-color: var(--color-gl-pink);
        --logo-shift-x: 0px;
        --logo-shift-y: 0px;
        --logo-cut-top: 0%;
        --logo-cut-bottom: 0%;
        --logo-glitch-opacity: 0;

        position: relative;
        display: inline-block;
        width: var(--logo-size);
        aspect-ratio: 1;
        color: var(--logo-color);
        filter: drop-shadow(
            0 0 0.7rem color-mix(in srgb, var(--logo-color), transparent 78%)
        );
    }

    .logo-glitch__layer,
    .logo-glitch__scan {
        position: absolute;
        inset: 0;
        display: block;
        background-color: currentColor;
        mask: var(--logo-url) center / contain no-repeat;
        -webkit-mask: var(--logo-url) center / contain no-repeat;
    }

    .logo-glitch__layer--base {
        color: var(--logo-color);
    }

    .logo-glitch__layer--hot,
    .logo-glitch__layer--cold,
    .logo-glitch__scan {
        opacity: var(--logo-glitch-opacity);
        pointer-events: none;
    }

    .logo-glitch__layer--hot {
        color: var(--logo-glitch-color);
        clip-path: inset(var(--logo-cut-top) 0 var(--logo-cut-bottom) 0);
        transform: translate(var(--logo-shift-x), var(--logo-shift-y));
    }

    .logo-glitch__layer--cold {
        color: var(--color-gl-blue);
        clip-path: inset(var(--logo-cut-bottom) 0 var(--logo-cut-top) 0);
        transform: translate(
            calc(var(--logo-shift-x) * -0.75),
            calc(var(--logo-shift-y) * -0.75)
        );
        mix-blend-mode: screen;
    }

    .logo-glitch__scan {
        color: var(--color-gl-white);
        clip-path: inset(var(--logo-scan-top, 44%) 0 var(--logo-scan-bottom, 50%) 0);
        transform: translateX(calc(var(--logo-shift-x) * 1.35));
        mix-blend-mode: screen;
    }

    .logo-glitch[data-glitching] .logo-glitch__layer--base {
        transform: translate(
            calc(var(--logo-shift-x) * -0.12),
            calc(var(--logo-shift-y) * -0.12)
        );
    }
</style>

<script>
    function randomBetween(min, max) {
        return min + Math.random() * (max - min);
    }

    function randomInt(min, max) {
        return Math.floor(randomBetween(min, max + 1));
    }

    function bootLogoGlitch() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        document.querySelectorAll("[data-logo-glitch]").forEach((logo) => {
            if (!(logo instanceof HTMLElement) || logo.dataset.ready) return;
            logo.dataset.ready = "true";

            let timeout = 0;
            let interval = 0;

            function setFrame(strength) {
                const sliceTop = randomInt(0, 74);
                const sliceHeight = randomInt(8, 22);
                const scanTop = randomInt(8, 82);

                logo.style.setProperty(
                    "--logo-shift-x",
                    `${randomBetween(-4, 4) * strength}px`,
                );
                logo.style.setProperty(
                    "--logo-shift-y",
                    `${randomBetween(-2, 2) * strength}px`,
                );
                logo.style.setProperty("--logo-cut-top", `${sliceTop}%`);
                logo.style.setProperty(
                    "--logo-cut-bottom",
                    `${Math.max(0, 100 - sliceTop - sliceHeight)}%`,
                );
                logo.style.setProperty("--logo-scan-top", `${scanTop}%`);
                logo.style.setProperty(
                    "--logo-scan-bottom",
                    `${Math.max(0, 100 - scanTop - randomInt(3, 9))}%`,
                );
                logo.style.setProperty(
                    "--logo-glitch-opacity",
                    `${randomBetween(0.42, 0.86)}`,
                );
            }

            function reset() {
                logo.removeAttribute("data-glitching");
                logo.style.setProperty("--logo-glitch-opacity", "0");
                logo.style.setProperty("--logo-shift-x", "0px");
                logo.style.setProperty("--logo-shift-y", "0px");
            }

            function schedule() {
                window.clearTimeout(timeout);
                timeout = window.setTimeout(() => burst(1), randomBetween(3200, 8200));
            }

            function finish() {
                window.clearInterval(interval);
                reset();
                schedule();
            }

            function burst(strength) {
                window.clearTimeout(timeout);
                window.clearInterval(interval);

                let frame = 0;
                const frames = randomInt(4, 8);

                logo.setAttribute("data-glitching", "true");
                setFrame(strength);

                interval = window.setInterval(() => {
                    setFrame(strength);
                    frame += 1;

                    if (frame >= frames) finish();
                }, randomBetween(45, 85));
            }

            logo.addEventListener("mouseenter", () => burst(1.65));
            schedule();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootLogoGlitch);
    } else {
        bootLogoGlitch();
    }
</script>
