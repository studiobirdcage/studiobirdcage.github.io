---
import BaseHead from "../components/BaseHead.astro";
import Menu from "../components/Menu.astro";
import PixelBackground from "../components/PixelBackground.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { getAllSeries } from "../utils/series";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const newestSeries = getAllSeries(posts).slice(0, 5);

interface props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} />
    </head>
    <body class="max-w-6xl px-6 pb-12">
        <PixelBackground />
        <Menu />

        <main class="relative z-10 grid grid-cols-12 gap-12">
            <aside class="col-span-3 hidden lg:block">
                <div
                    class="sticky top-8 border-t border-dashed border-gl-muted/70 py-4 text-xl leading-7 text-gl-white"
                >
                    <slot name="sidebar">
                        <section
                            class="border-b border-dashed border-gl-muted/70 pb-2"
                        >
                            <p class="mb-3 text-gl-cyan">---[ about ]---</p>
                            <p>
                                Studio Birdcage is my home for experiments,
                                projects, writing, glitches, web scraps,
                                resources and whatever falls out of the machine.
                            </p>
                            <p class="mt-4 text-gl-muted">
                                + independent web<br />
                                + pixel noise<br />
                                + damn the man
                            </p>
                        </section>
                        <section class="pt-4" aria-labelledby="series-heading">
                            <div
                                class="mb-3 flex items-baseline justify-between gap-3"
                            >
                                <p id="series-heading" class="text-gl-cyan">
                                    ---[ newest series ]---
                                </p>
                            </div>
                            {
                                newestSeries.length > 0 ? (
                                    <ol class="space-y-3">
                                        {newestSeries.map((series) => (
                                            <li class="border-b border-dashed border-gl-muted/70 pb-3">
                                                <a
                                                    class="block text-xl leading-6 text-gl-yellow hover:bg-gl-cyan/10 hover:text-gl-cyan"
                                                    href={`/series/${series.slug}/`}
                                                >
                                                    <span class="text-gl-muted">
                                                        &gt;
                                                    </span>{" "}
                                                    {series.title}
                                                </a>
                                                <p class="text-base leading-5 text-gl-muted">
                                                    {series.posts.length} file
                                                    {series.posts.length === 1
                                                        ? ""
                                                        : "s"}
                                                    <br />
                                                    latest{" "}
                                                    <FormattedDate
                                                        date={series.latestDate}
                                                    />
                                                </p>
                                            </li>
                                        ))}
                                    </ol>
                                ) : (
                                    <p class="text-gl-muted">
                                        No linked transmissions yet.
                                    </p>
                                )
                            }
                        </section>
                    </slot>
                </div>
            </aside>

            <article class="col-span-12 lg:col-span-9">
                <slot />
            </article>
        </main>
    </body>
</html>
