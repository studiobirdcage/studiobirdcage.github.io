---
import BaseLayout from "../layouts/BaseLayout.astro";
import AsciiBanner from "../components/AsciiBanner.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { SeriesNav } from "../utils/series";

type Props = CollectionEntry<"blog">["data"] & {
    headings?: MarkdownHeading[];
    seriesNav?: SeriesNav;
};

const {
    title,
    description,
    pubDate,
    updatedDate,
    heroImage,
    headings = [],
    seriesNav,
} = Astro.props as Props;

const tocHeadings = headings.filter(
    (heading) => heading.depth >= 2 && heading.depth <= 3,
);
---

<BaseLayout title={title} description={description}>
    <Fragment slot="sidebar">
        <p class="mb-3 text-gl-cyan">---[ contents ]---</p>
        {
            tocHeadings.length > 0 ? (
                <nav aria-label="Table of contents">
                    <ol class="space-y-2 text-lg leading-6">
                        {tocHeadings.map((heading) => (
                            <li
                                class:list={[
                                    "toc-item border-l border-dashed border-gl-muted/60 pl-3",
                                    heading.depth === 3 && "ml-4 text-gl-muted",
                                ]}
                                data-toc-item
                            >
                                <a
                                    class="toc-link"
                                    href={`#${heading.slug}`}
                                    data-toc-link={heading.slug}
                                >
                                    <span class="toc-caret" aria-hidden="true">
                                        &gt;
                                    </span>{" "}
                                    {heading.text}
                                </a>
                            </li>
                        ))}
                    </ol>
                </nav>
            ) : (
                <p class="text-gl-muted">No transmission index found.</p>
            )
        }
    </Fragment>

    <div class="prose">
        <div class="title border-b-4 border-gl-muted border-double pb-4">
            <nav class="site-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Index</a>
                <span aria-hidden="true"> / </span>
                <span class="site-breadcrumb__current" aria-current="page">
                    {title}
                </span>
            </nav>

            <div class="date">
                <FormattedDate date={pubDate} />
                {
                    updatedDate && (
                        <div class="last-updated-on">
                            Last updated on <FormattedDate date={updatedDate} />
                        </div>
                    )
                }
            </div>
            <AsciiBanner
                text={title}
                size="0.5rem"
                wrapAt="auto"
                glitchAmount="25%"
                font="ANSI Shadow"
                color="var(--color-gl-yellow)"
                glitchColor="var(--color-gl-cyan)"
            />
        </div>
        <div class="hero-image py-8">
            {
                heroImage && (
                    <Image width={1020} height={510} src={heroImage} alt="" />
                )
            }
        </div>
        <div data-blog-content class="pb-[35vh]">
            <slot />

            {
                seriesNav && (
                    <nav
                        class="mt-16 border-y border-dashed border-gl-muted/70 py-6"
                        aria-label="Series navigation"
                    >
                        <div class="mb-5 flex flex-col gap-2 border-b border-dashed border-gl-muted/60 pb-4 md:flex-row md:items-end md:justify-between">
                            <div>
                                <p class="text-lg uppercase tracking-[0.18em] text-gl-muted">
                                    linked transmission
                                </p>
                                <p class="text-2xl leading-7 text-gl-cyan">
                                    ---[ {seriesNav.series.title} ]---
                                </p>
                            </div>
                            <a
                                class="text-xl text-gl-muted hover:bg-gl-cyan/10 hover:text-gl-cyan"
                                href={`/series/${seriesNav.series.slug}/`}
                            >
                                [view series index]
                            </a>
                        </div>

                        <div class="grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-stretch">
                            <div class="border-l border-dashed border-gl-muted/70 py-3 pl-4">
                                <p class="mb-2 text-lg uppercase tracking-wider text-gl-muted">
                                    previous file
                                </p>
                                {seriesNav.previous ? (
                                    <a
                                        class="block text-2xl leading-7 text-gl-yellow hover:bg-gl-cyan/10 hover:text-gl-cyan"
                                        href={`/blog/${seriesNav.previous.id}/`}
                                    >
                                        <span class="text-gl-muted">&lt;</span>{" "}
                                        {seriesNav.previous.data.title}
                                    </a>
                                ) : (
                                    <span class="block text-xl leading-7 text-gl-muted">
                                        <span aria-hidden="true">&lt;</span>{" "}
                                        start of series
                                    </span>
                                )}
                            </div>

                            <div
                                class="hidden border-l border-dashed border-gl-muted/60 md:block"
                                aria-hidden="true"
                            ></div>

                            <div class="border-r border-dashed border-gl-muted/70 py-3 pr-4 md:text-right">
                                <p class="mb-2 text-lg uppercase tracking-wider text-gl-muted">
                                    next file
                                </p>
                                {seriesNav.next ? (
                                    <a
                                        class="block text-2xl leading-7 text-gl-yellow hover:bg-gl-cyan/10 hover:text-gl-cyan"
                                        href={`/blog/${seriesNav.next.id}/`}
                                    >
                                        {seriesNav.next.data.title}{" "}
                                        <span class="text-gl-muted">&gt;</span>
                                    </a>
                                ) : (
                                    <span class="block text-xl leading-7 text-gl-muted">
                                        end of series{" "}
                                        <span aria-hidden="true">&gt;</span>
                                    </span>
                                )}
                            </div>
                        </div>
                    </nav>
                )
            }
        </div>
    </div>
</BaseLayout>

<script>
    function bootTableOfContents() {
        const links = Array.from(document.querySelectorAll("[data-toc-link]"));
        if (links.length === 0) return;

        const entries = links
            .map((link) => {
                if (!(link instanceof HTMLAnchorElement)) return undefined;

                const id = link.dataset.tocLink;
                const heading = id ? document.getElementById(id) : null;

                return heading ? { link, heading } : undefined;
            })
            .filter(Boolean);

        if (entries.length === 0) return;

        let activeId = "";
        let ticking = false;

        function setActive(id) {
            if (id === activeId) return;
            activeId = id;

            entries.forEach(({ link, heading }) => {
                const isActive = heading.id === id;
                const item = link.closest("[data-toc-item]");

                link.toggleAttribute("aria-current", isActive);
                if (isActive) {
                    link.setAttribute("aria-current", "location");
                }
                item?.toggleAttribute("data-active", isActive);
            });
        }

        function updateActiveHeading() {
            ticking = false;

            const documentElement = document.documentElement;
            const distanceFromBottom =
                documentElement.scrollHeight -
                window.scrollY -
                window.innerHeight;

            if (distanceFromBottom < 12) {
                setActive(entries[entries.length - 1].heading.id);
                return;
            }

            const offset = Math.min(window.innerHeight * 0.28, 220);
            let current = entries[0];

            for (const entry of entries) {
                const top = entry.heading.getBoundingClientRect().top;

                if (top <= offset) {
                    current = entry;
                } else {
                    break;
                }
            }

            if (current) setActive(current.heading.id);
        }

        function requestUpdate() {
            if (ticking) return;
            ticking = true;
            window.requestAnimationFrame(updateActiveHeading);
        }

        links.forEach((link) => {
            link.addEventListener("click", () => {
                const id = link.dataset.tocLink;
                if (id) window.setTimeout(() => setActive(id), 80);
            });
        });

        updateActiveHeading();
        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate, { passive: true });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", bootTableOfContents);
    } else {
        bootTableOfContents();
    }
</script>
